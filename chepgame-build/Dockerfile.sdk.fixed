# CHEPGAME.NET ProsperoMgr PS5 SDK image
# SDK setup follows itsPLK/ps5-webkit-autoloader: build ps5-payload-dev/sdk from source.
FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG PS5_SDK_VERSION=0.43
ARG NODE_VERSION=22.16.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    clang-18 \
    cmake \
    file \
    git \
    lld-18 \
    make \
    ninja-build \
    pkg-config \
    python3 \
    python3-pyelftools \
    unzip \
    wget \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/clang-18 /usr/local/bin/clang && \
    ln -sf /usr/bin/clang++-18 /usr/local/bin/clang++ && \
    ln -sf /usr/bin/ld.lld-18 /usr/local/bin/ld.lld

RUN set -eux; \
    case "$(dpkg --print-architecture)" in \
      amd64) NODE_ARCH=x64 ;; \
      arm64) NODE_ARCH=arm64 ;; \
      *) echo "Unsupported Docker host architecture: $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac; \
    wget -q "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" -O /tmp/node.tar.xz; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1; \
    rm -f /tmp/node.tar.xz; \
    node --version; \
    npm --version

WORKDIR /opt
RUN git clone --depth 1 --branch "v${PS5_SDK_VERSION}" https://github.com/ps5-payload-dev/sdk.git ps5-payload-sdk-source && \
    cd /opt/ps5-payload-sdk-source && \
    make DESTDIR=/opt/ps5-payload-sdk install && \
    test -f /opt/ps5-payload-sdk/toolchain/prospero.mk && \
    test -x /opt/ps5-payload-sdk/bin/prospero-clang

ENV PS5_PAYLOAD_SDK=/opt/ps5-payload-sdk
ENV PATH=/opt/ps5-payload-sdk/bin:/usr/local/bin:/usr/bin:/bin

WORKDIR /opt
COPY build_deps_docker.sh /opt/build_deps_docker.sh
RUN chmod +x /opt/build_deps_docker.sh && /opt/build_deps_docker.sh

RUN test -f /opt/ps5-payload-sdk/target/lib/libmicrohttpd.a && \
    test -f /opt/ps5-payload-sdk/target/lib/libmbedcrypto.a && \
    prospero-clang --version && \
    node --version

WORKDIR /src
